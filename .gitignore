# =====================================================================
#  spinlens · 话术照妖镜 · .gitignore
#  红线：抓取下来的评论语料、人工标注、训练数据、模型权重、本机运行
#        产物，一律不进仓库。研究资产只留本机，不发布、不删除。
# =====================================================================

# ── 研究区：整块不发布 ────────────────────────────────────────────────
# lab/ 里有爬取语料、人工标注、训练脚本与模型权重；_recovered/ 里有带
# 本机路径的会话记录。两者都只是「不上传」，文件本身完整保留在本机。
lab/
_recovered/

# ── 依赖与虚拟环境（本项目零依赖，这两个目录不该存在）────────────────
node_modules/
.venv/
venv/

# ── 模型权重（体积大，且是训练产物）──────────────────────────────────
*.safetensors
*.pt
*.pth
*.ckpt
*.onnx
*.bin

# ── 备份与临时文件（回滚点留本机，不发布）────────────────────────────
*.bak*
*.orig
*.rej
.tmp/
*.tmp
*.log

# ── 运行产物 ─────────────────────────────────────────────────────────
dist/
huashu-*.csv
*.low.csv
__pycache__/
*.pyc

# ── 依赖抓取语料的研究脚本（别人 clone 下来跑不了，故不发布）──────────
tools/agreement.cjs
tools/list-rules-hits.cjs
tools/make-step-candidates.cjs
tools/make-product-pack.cjs

# ── 编辑器 / 系统文件 ────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
.idea/
.vscode/
_*.mjs
_*.cjs
_*.json
